# Your Kie.ai API key — get one at https://kie.ai/api-key
KIE_AI_API_KEY=

# A password you invent yourself (any long random string). Claude must send
# this back on every request (as a static header) or anyone who finds your
# server's URL could spend your Kie.ai credits. Generate one with e.g.:
#   openssl rand -hex 24
MCP_SHARED_SECRET=

# Your server's public hostname once you know it, e.g. kie-mcp.onrender.com
# (no https://, no path). Leave blank while testing locally.
ALLOWED_HOSTS=

# Usually leave unset — Render/Railway/Fly set PORT automatically.
# PORT=3000
