{
  "name": "kie-ai-mcp-connector",
  "version": "1.0.0",
  "description": "Remote MCP server that connects Claude to the Kie.ai image generation API (banners, ads, GPT-Image, Flux Kontext, and any other Kie.ai model).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "dev": "tsc -p . && node dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
